# Yuz servisi (services/face). Bo'sh bo'lsa — yuz tekshirilmaydi, check-in «shubhali» (face_unavailable) bo'lib saqlanadi.
# Lokal: cd services/face && pip install -r requirements.txt && uvicorn app:app --port 8100
FACE_SERVICE_URL=
# Ixtiyoriy umumiy kalit (servisda ham FACE_SERVICE_KEY): X-Face-Key sarlavhasi
FACE_SERVICE_KEY=
